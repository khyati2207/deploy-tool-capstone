<mxfile host="app.diagrams.net" modified="2026-10-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="story" name="Deployment flow"><mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="1100"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="From React code to live website" style="text;html=1;align=left;fontSize=30;fontStyle=1;fontColor=#14233b" vertex="1" parent="1"><mxGeometry x="45" y="28" width="1400" height="52" as="geometry"/></mxCell><mxCell id="subtitle" value="A simple deployment journey: your CLI prepares the app, AWS serves it, and you manage each release." style="text;html=1;align=left;fontSize=16;fontColor=#52647d" vertex="1" parent="1"><mxGeometry x="47" y="82" width="1440" height="32" as="geometry"/></mxCell><mxCell id="step1" value="1  START&#xa;&#xa;Developer runs&#xa;deploy-tool deploy&#xa;From the React project" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#EAF2FF;strokeColor=#4B76C7;strokeWidth=2;fontSize=16;fontColor=#14233b;spacing=16;" vertex="1" parent="1"><mxGeometry x="45" y="180" width="340" height="205" as="geometry"/></mxCell><mxCell id="step2" value="2  CHECK&#xa;&#xa;CLI detects&#xa;CRA or Vite&#xa;Reads build settings" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F0EDFF;strokeColor=#8066C2;strokeWidth=2;fontSize=16;fontColor=#14233b;spacing=16;" vertex="1" parent="1"><mxGeometry x="430" y="180" width="340" height="205" as="geometry"/></mxCell><mxCell id="step3" value="3  INSTALL&#xa;&#xa;npm or yarn installs&#xa;project packages&#xa;Uses lockfile" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF5E4;strokeColor=#D6952F;strokeWidth=2;fontSize=16;fontColor=#14233b;spacing=16;" vertex="1" parent="1"><mxGeometry x="815" y="180" width="340" height="205" as="geometry"/></mxCell><mxCell id="step4" value="4  BUILD&#xa;&#xa;Docker runs&#xa;production build&#xa;Reuses build cache" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FFF8E8;strokeColor=#D6AD56;strokeWidth=2;fontSize=16;fontColor=#14233b;spacing=16;" vertex="1" parent="1"><mxGeometry x="1200" y="180" width="340" height="205" as="geometry"/></mxCell><mxCell id="step5" value="5  PROVISION&#xa;&#xa;Terraform prepares&#xa;an S3 bucket&#xa;Sets hosting + versioning" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#EAF7EF;strokeColor=#359269;strokeWidth=2;fontSize=16;fontColor=#14233b;spacing=16;" vertex="1" parent="1"><mxGeometry x="1200" y="455" width="340" height="205" as="geometry"/></mxCell><mxCell id="step6" value="6  PUBLISH&#xa;&#xa;Python CLI + boto3&#xa;uploads the build&#xa;S3 keeps release versions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E8F4FB;strokeColor=#3984B8;strokeWidth=2;fontSize=16;fontColor=#14233b;spacing=16;" vertex="1" parent="1"><mxGeometry x="815" y="455" width="340" height="205" as="geometry"/></mxCell><mxCell id="step7" value="7  VISIT&#xa;&#xa;Browser opens&#xa;the website URL&#xa;Optional CloudFront" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#EAF4FF;strokeColor=#3984B8;strokeWidth=2;fontSize=16;fontColor=#14233b;spacing=16;" vertex="1" parent="1"><mxGeometry x="430" y="455" width="340" height="205" as="geometry"/></mxCell><mxCell id="step8" value="8  MANAGE&#xa;&#xa;CLI shows status&#xa;or rolls back&#xa;Restore previous release" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#F0EDFF;strokeColor=#8066C2;strokeWidth=2;fontSize=16;fontColor=#14233b;spacing=16;" vertex="1" parent="1"><mxGeometry x="45" y="455" width="340" height="205" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=3;strokeColor=#566b82;" edge="1" parent="1" source="step1" target="step2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=3;strokeColor=#566b82;" edge="1" parent="1" source="step2" target="step3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=3;strokeColor=#566b82;" edge="1" parent="1" source="step3" target="step4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=3;strokeColor=#566b82;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step4" target="step5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=3;strokeColor=#566b82;" edge="1" parent="1" source="step5" target="step6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=3;strokeColor=#566b82;" edge="1" parent="1" source="step6" target="step7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=3;strokeColor=#566b82;" edge="1" parent="1" source="step7" target="step8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lane1" value="YOUR PROJECT" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#52647d" vertex="1" parent="1"><mxGeometry x="45" y="145" width="150" height="25" as="geometry"/></mxCell><mxCell id="lane2" value="BUILD + AWS" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#52647d" vertex="1" parent="1"><mxGeometry x="45" y="420" width="150" height="25" as="geometry"/></mxCell><mxCell id="legend" value="WHAT EACH TOOL DOES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;fontSize=14;fontStyle=1" vertex="1" parent="1"><mxGeometry x="45" y="745" width="300" height="40" as="geometry"/></mxCell><mxCell id="tools" value="Python CLI: the commands and deployment coordinator     •     Docker + Node.js: repeatable, isolated React builds&#xa;Terraform: creates AWS resources     •     boto3: calls AWS APIs and uploads files     •     S3: hosts the site and keeps versions for rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=16;spacing=15" vertex="1" parent="1"><mxGeometry x="45" y="800" width="1510" height="90" as="geometry"/></mxCell><mxCell id="auto" value="OPTIONAL: GitHub Actions or GitLab CI can run the same deployment after a code push. Keep AWS credentials in CI secrets.  |  Standard React sites need S3, not EC2. Monitoring stack excluded." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7FA;strokeColor=#BC6482;strokeWidth=1;fontSize=15;spacing=14" vertex="1" parent="1"><mxGeometry x="45" y="925" width="1510" height="65" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>

